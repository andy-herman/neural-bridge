# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Neural Bridge — personal data, gitignored by default
# Directories are kept via .gitkeep so the structure persists
daily-logs/*
!daily-logs/.gitkeep
raw/*
!raw/.gitkeep
knowledge/agents/*/*
!knowledge/agents/*/.gitkeep

# Coding-agent local state
.claude/local/
*.session.json

# recall.py local vector DB — machine-local, never synced or committed
data/recall/

# Outbound guard index and audit log (scripts/outbound_guard.py): keyed hashes
# and counts only, machine-local. The private policy and the hash key live
# outside the repo, in ~/.config/neural-bridge/.
data/outbound_guard/

# compile.py / lint.py outputs — run-time, not tracked
docs/compile/*
!docs/compile/.gitkeep
docs/lint/*
!docs/lint/.gitkeep
# scripts/echo/synthesize_profile.py run logs carry the raw synthesis output
# about Andy, so they stay local like the compile and lint run logs.
docs/echo-synthesis/
scripts/.compile_state.json
scripts/.inflight_mentions.json

# Loop engineer per-issue worktrees. Live under this clone but must never be
# committed and must stay invisible to the auto-reload watcher's `main` view.
.trees/

# Optional local env overrides read by scripts/env_file.py. Holds tokens.
.env
.env.*
!.env.example
