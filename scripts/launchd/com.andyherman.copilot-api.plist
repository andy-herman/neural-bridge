<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andyherman.copilot-api</string>

    <!-- The local proxy that translates Anthropic /v1/messages into GitHub
         Copilot calls, so `claude -p` (the whole NB fleet) and Synapse can run
         Claude models on Andy's flat Copilot subscription. Runs on :4141.
         Previously started by hand via npx; managing it here means it survives
         reboots and restarts on crash. GitHub token is cached at
         ~/.local/share/copilot-api/github_token, so HOME below lets it reuse
         the token with no interactive re-auth. caffeinate keeps it awake. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-s</string>
        <string>-i</string>
        <string>/Users/andyherman/.local/bin/npx</string>
        <string>-y</string>
        <string>copilot-api@latest</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/andyherman</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/andyherman/Library/Logs/neural-bridge/copilot-api.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/andyherman/Library/Logs/neural-bridge/copilot-api.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>USER</key>
        <string>andyherman</string>
        <key>HOME</key>
        <string>/Users/andyherman</string>
        <key>PATH</key>
        <string>/Users/andyherman/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
