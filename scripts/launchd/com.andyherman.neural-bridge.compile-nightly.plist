<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andyherman.neural-bridge.compile-nightly</string>

    <!-- Nightly compile pass, staged (scripts/review_queue/promotions.py):
         compile.py runs the filing gate over new daily-logs/<agent>/*.md
         entries into a private copy of knowledge/ at .trees/compile-staging,
         and every article it promotes or quarantines becomes a review queue
         card with a private preview in the vault. Nothing lands in the
         shared checkout or on GitHub until Andy files it. Per ADR-007.

         No Discord summary (compile runs with no-discord): the cards are the
         notice. Since 2026-10-16; before that compile.py ran here directly
         and wrote into the shared checkout. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/andyherman/Development/neural-bridge/.venv/bin/python</string>
        <string>-m</string>
        <string>scripts.review_queue.promotions</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/andyherman/Development/neural-bridge</string>

    <!-- 03:00 local time daily. Late enough that any active session is
         finished, early enough to be done before morning standup. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- One-shot per fire; do not keep alive between runs. -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/andyherman/Library/Logs/neural-bridge/compile-nightly.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/andyherman/Library/Logs/neural-bridge/compile-nightly.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>USER</key>
        <string>andyherman</string>
        <key>HOME</key>
        <string>/Users/andyherman</string>
        <!-- PATH includes ~/.local/bin so `claude` resolves; Homebrew for `gh`. -->
        <key>PATH</key>
        <string>/Users/andyherman/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Nightly run can be slow (filing gate + concept writer per candidate
         + log refresh). Background priority + nice 10 keeps it gentle. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
